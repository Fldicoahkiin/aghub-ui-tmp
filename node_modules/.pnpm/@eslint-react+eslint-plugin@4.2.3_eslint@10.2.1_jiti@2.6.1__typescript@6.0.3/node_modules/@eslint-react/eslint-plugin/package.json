{
  "name": "@eslint-react/eslint-plugin",
  "version": "4.2.3",
  "description": "A unified plugin that combines all individual plugins from the eslint-react monorepo into one.",
  "keywords": [
    "react",
    "eslint",
    "eslint-react",
    "eslint-plugin",
    "eslint-plugin-react-x",
    "eslint-plugin-react-jsx",
    "eslint-plugin-react-rsc",
    "eslint-plugin-react-dom",
    "eslint-plugin-react-web-api",
    "eslint-plugin-react-naming-convention"
  ],
  "homepage": "https://github.com/Rel1cx/eslint-react",
  "bugs": {
    "url": "https://github.com/Rel1cx/eslint-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rel1cx/eslint-react.git",
    "directory": "packages/plugins/eslint-plugin"
  },
  "license": "MIT",
  "author": "Rel1cx",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "./package.json"
  ],
  "dependencies": {
    "@typescript-eslint/scope-manager": "^8.58.0",
    "@typescript-eslint/type-utils": "^8.58.0",
    "@typescript-eslint/types": "^8.58.0",
    "@typescript-eslint/utils": "^8.58.0",
    "ts-api-utils": "^2.5.0",
    "@eslint-react/shared": "4.2.3",
    "eslint-plugin-react-dom": "4.2.3",
    "eslint-plugin-react-jsx": "4.2.3",
    "eslint-plugin-react-naming-convention": "4.2.3",
    "eslint-plugin-react-web-api": "4.2.3",
    "eslint-plugin-react-x": "4.2.3",
    "eslint-plugin-react-rsc": "4.2.3"
  },
  "devDependencies": {
    "tsdown": "^0.21.7",
    "@local/configs": "0.0.0",
    "@local/eff": "3.0.0-beta.72"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "inlinedDependencies": {
    "@local/eff": "workspace:*"
  },
  "scripts": {
    "build": "tsdown",
    "lint:publish": "pnpm publint",
    "lint:ts": "tsl"
  }
}
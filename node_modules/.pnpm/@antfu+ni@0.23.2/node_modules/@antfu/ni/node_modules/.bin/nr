#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/mac/WorkSpace/Frontend_Project/provider-design/node_modules/.pnpm/@antfu+ni@0.23.2/node_modules/@antfu/ni/node_modules:/Users/mac/WorkSpace/Frontend_Project/provider-design/node_modules/.pnpm/@antfu+ni@0.23.2/node_modules:/Users/mac/WorkSpace/Frontend_Project/provider-design/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/mac/WorkSpace/Frontend_Project/provider-design/node_modules/.pnpm/@antfu+ni@0.23.2/node_modules/@antfu/ni/node_modules:/Users/mac/WorkSpace/Frontend_Project/provider-design/node_modules/.pnpm/@antfu+ni@0.23.2/node_modules:/Users/mac/WorkSpace/Frontend_Project/provider-design/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/nr.mjs" "$@"
else
  exec node  "$basedir/../../bin/nr.mjs" "$@"
fi
